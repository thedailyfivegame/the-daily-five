{
  "version": 2,
  "routes": [
    {
      "src": "/play",
      "dest": "/play.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "crons": [
    {
      "path": "/api/send-daily-push",
      "schedule": "0 8 * * *"
    }
  ]
}